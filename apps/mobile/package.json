{
  "name": "@voliere/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "mobile": "yarn run start",
    "start": "cross-env EXPO_NO_CACHE=1 expo start",
    "android": "cross-env EXPO_NO_CACHE=1 expo start --android",
    "ios": "cross-env EXPO_NO_CACHE=1 expo start --ios",
    "web": "cross-env EXPO_NO_CACHE=1 expo start --web",
    "start:no-dep-check": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_NO_CACHE=1 expo start"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
