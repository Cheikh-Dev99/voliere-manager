    "expo-file-system": "~19.0.22",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.13.0",
    "lucide-react-native": "^0.554.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
