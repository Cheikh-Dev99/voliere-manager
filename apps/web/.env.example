# Copier vers .env.local et remplir (Console Firebase → Paramètres du projet → Tes applications → Config SDK)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optionnel : les photos fichier sont en localStorage ; le bucket sert si tu actives l’upload Firebase Storage.
# Utile plus tard si tu actives Firebase Storage (Blaze) : mon-app.appspot.com (sans gs://)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mails de réinitialisation : dans Firebase Console → Authentication → Paramètres → Domaines autorisés,
# ajoute l’origine exacte de ton app (ex. http://localhost:5173, http://127.0.0.1:5173, https://ton-domaine.com).
