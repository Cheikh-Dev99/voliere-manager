rules_version = '2';

// Déployer : Firebase CLI → `firebase deploy --only storage`
// Ou coller ces règles dans Console Firebase → Build → Storage → Règles

service firebase.storage {
  match /b/{bucket}/o {
    // Photos pigeon : un utilisateur authentifié ne peut écrire que sous son propre dossier
    match /pigeons/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
