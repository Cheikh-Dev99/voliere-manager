rules_version = '2';

// Déployer : Firebase CLI → `firebase deploy --only storage`
// Ou coller ces règles dans Console Firebase → Build → Storage → Règles

service firebase.storage {
  match /b/{bucket}/o {
    // Photos pigeon : lecture / écriture réservées au propriétaire authentifié
    match /pigeons/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
